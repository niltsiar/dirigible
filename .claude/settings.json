{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(swift:*)",
      "Bash(xcrun:*)",
      "Bash(scripts/bundle.sh:*)",
      "Bash(.claude/skills/deliver/scripts/new-run.sh:*)",
      "Bash(codesign:*)",
      "Bash(plutil:*)",
      "Bash(lipo:*)",
      "Bash(vtool:*)",
      "Bash(otool:*)",
      "Bash(afinfo:*)",
      "Bash(afconvert:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(xmllint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(git switch main)",
      "Bash(git switch feat/:*)",
      "Bash(git switch fix/:*)",
      "Bash(git switch test/:*)",
      "Bash(git switch refactor/:*)",
      "Bash(git switch perf/:*)",
      "Bash(git switch docs/:*)",
      "Bash(git switch build/:*)",
      "Bash(git switch chore/:*)",
      "Bash(git switch style/:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch -d:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo view:*)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git stash push:*)",
      "Bash(git stash pop)",
      "Bash(git stash list)",
      "Bash(git config --local core.hooksPath .githooks)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git config --global:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit -n:*)",
      "Bash(git branch -d -f:*)",
      "Bash(git branch -d --force:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git branch -f:*)",
      "Bash(git config --local --unset core.hooksPath:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guardrails.sh"
          }
        ]
      }
    ]
  }
}
