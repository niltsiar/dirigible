{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(swift:*)",
      "Bash(xcrun:*)",
      "Bash(scripts/bundle.sh:*)",
      "Bash(.claude/skills/deliver/scripts/new-run.sh:*)",
      "Bash(codesign:*)",
      "Bash(plutil:*)",
      "Bash(lipo:*)",
      "Bash(vtool:*)",
      "Bash(otool:*)",
      "Bash(afinfo:*)",
      "Bash(afconvert:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(xmllint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(git switch main)",
      "Bash(git switch feat/:*)",
      "Bash(git switch fix/:*)",
      "Bash(git switch test/:*)",
      "Bash(git switch refactor/:*)",
      "Bash(git switch perf/:*)",
      "Bash(git switch docs/:*)",
      "Bash(git switch build/:*)",
      "Bash(git switch chore/:*)",
      "Bash(git switch style/:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch -d:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(git rebase main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git stash push:*)",
      "Bash(git stash pop)",
      "Bash(git stash list)",
      "Bash(git config --local core.hooksPath:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git config --global:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git switch --discard-changes:*)"
    ]
  }
}
