#!/bin/bash
# Refuse a commit that fails the format check. It checks the working tree, not only the staged
# files. `make setup` enables this hook. Tests run in the tdd loop and in the push check, not here.
set -euo pipefail
[[ "$(git config --get core.hooksPath)" == .githooks ]] ||
  { echo "pre-commit: core.hooksPath is not .githooks, so a worktree runs the hooks of another tree. Run make setup." >&2; exit 1; }
# A make check-changed run marks its tree with the pid of its recipe shell (scripts/run-checks.sh,
# check-changed.sh --wait-load). A commit during the run makes its pass stamp useless.
for f in "$(git rev-parse --path-format=absolute --git-dir)"/dirigible-check-running/*; do
  pid="${f##*/}"
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null &&
    { echo "pre-commit: a make check-changed run (pid $pid) checks this tree. Commit after it ends: a commit makes its pass stamp useless." >&2; exit 1; }
done
make --no-print-directory lint
